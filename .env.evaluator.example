# Evaluator local run. Copy to .env and set MINSKY_LLM_API_KEY only.
# Then: docker compose -f compose.yaml -f compose.evaluator.yaml up --build
# Open https://localhost/chat (accept the local Caddy certificate warning).
# Reset: docker compose -f compose.yaml -f compose.evaluator.yaml down -v
# Generated by infra/evaluator_pack.py (synthetic); sessions expire 2026-10-17T00:00:00+00:00.
#
# The credentials below are PUBLIC and fixed on purpose: they only work on a stack on localhost
# (compose.evaluator.yaml pins DOMAIN and MINSKY_ENVIRONMENT). Never use this file on a reachable host:
# there, generate random ones with `make demo-sessions`.

DOMAIN=localhost
MINSKY_ENVIRONMENT=local
POSTGRES_USER=minsky
POSTGRES_PASSWORD=minsky
POSTGRES_DB=minsky

MINSKY_LLM_BASE_URL=https://api.openai.com/v1
MINSKY_LLM_MODEL=gpt-6-luna
MINSKY_LLM_API_KEY=

MINSKY_TEST_SESSIONS={"demo-d09-evaluator":{"customer_id":"CLI-EVAL-D09-01","expires_at":"2026-10-17T00:00:00+00:00"},"demo-d01-evaluator":{"customer_id":"CLI-EVAL-D01-02","expires_at":"2026-10-17T00:00:00+00:00"},"demo-d02-evaluator":{"customer_id":"CLI-EVAL-D02-03","expires_at":"2026-10-17T00:00:00+00:00"},"demo-d06-evaluator":{"customer_id":"CLI-EVAL-D06-04","expires_at":"2026-10-17T00:00:00+00:00"},"demo-d07-evaluator":{"customer_id":"CLI-EVAL-D07-05","expires_at":"2026-10-17T00:00:00+00:00"},"demo-d08-evaluator":{"customer_id":"CLI-EVAL-D08-06","expires_at":"2026-10-17T00:00:00+00:00"},"demo-d05-evaluator":{"customer_id":"CLI-EVAL-D05-07","expires_at":"2026-10-17T00:00:00+00:00"}}
MINSKY_STAFF_SESSIONS={"staff-ana-evaluator":{"agent_id":"ana.fraude","expires_at":"2026-10-17T00:00:00+00:00"},"staff-luis-evaluator":{"agent_id":"luis.disputas","expires_at":"2026-10-17T00:00:00+00:00"}}

# ---------------------------------------------------------------------------
# Cheat sheet: paste a credential in /chat, then type the es or pt message.
# ---------------------------------------------------------------------------
# D09-eligible (case opened automatically)
#   credential: demo-d09-evaluator
#   es: Quiero reclamar un cargo de 25.37 USD en Farmacias del Ahorro del 2026-06-10, el monto no es correcto.
#   pt: Quero contestar uma cobrança de 25.37 USD em Farmacias del Ahorro do dia 2026-06-10, o valor está errado.
#
# D01-declined-not-charged (nothing to dispute: the payment was declined)
#   credential: demo-d01-evaluator
#   es: Quiero reclamar un cargo de 40.00 USD en Super Ahorro del 2026-06-08, el monto no es correcto.
#   pt: Quero contestar uma cobrança de 40.00 USD em Super Ahorro do dia 2026-06-08, o valor está errado.
#
# D02-already-reversed (nothing to dispute: already refunded)
#   credential: demo-d02-evaluator
#   es: Quiero reclamar un cargo de 18.50 USD en Cafe Central del 2026-06-05, el monto no es correcto.
#   pt: Quero contestar uma cobrança de 18.50 USD em Cafe Central do dia 2026-06-05, o valor está errado.
#
# D06-possible-fraud (customer says it wasn't them: card block offer + fraud team)
#   credential: demo-d06-evaluator
#   es: Tengo un cargo de 25.00 USD en Cafe del 2026-06-10 que yo no hice.
#   pt: Tenho uma cobrança de 25.00 USD em Cafe do dia 2026-06-10 que eu não fiz.
#
# D07-above-auto-limit (amount above USD 500: dispute agent)
#   credential: demo-d07-evaluator
#   es: Quiero reclamar un cargo de 750.00 USD en Electrónica Sur del 2026-06-01, el monto no es correcto.
#   pt: Quero contestar uma cobrança de 750.00 USD em Electrónica Sur do dia 2026-06-01, o valor está errado.
#
# D08-repeat-complainer (repeat complainer: dispute agent)
#   credential: demo-d08-evaluator
#   es: Quiero reclamar un cargo de 55.00 USD en Mercado Norte del 2026-05-20, el monto no es correcto.
#   pt: Quero contestar uma cobrança de 55.00 USD em Mercado Norte do dia 2026-05-20, o valor está errado.
#
# D05-outside-window (older than 120 days: explained, agent offered)
#   credential: demo-d05-evaluator
#   es: Quiero reclamar un cargo de 90.00 USD en Hotel Sol del 2025-12-01, el monto no es correcto.
#   pt: Quero contestar uma cobrança de 90.00 USD em Hotel Sol do dia 2025-12-01, o valor está errado.
#
# Agent console: https://localhost/console
#   ana.fraude: staff-ana-evaluator
#   luis.disputas: staff-luis-evaluator
