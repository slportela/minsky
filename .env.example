# Copy to .env (git-ignored). Never commit real values.
# See README §9 Quick start and docs/demo.md for the full local path.

# =============================================================================
# Required to start the stack (make up → https://localhost)
# =============================================================================
DOMAIN=localhost                  # local CA via Caddy; public domain uses ACME
MINSKY_ENVIRONMENT=local
POSTGRES_USER=minsky
# Must match load_gold.py's default (minsky:minsky@127.0.0.1:5433) or set GOLD_DATABASE_URL.
POSTGRES_PASSWORD=minsky
POSTGRES_DB=minsky
POSTGRES_HOST_PORT=5433           # host port for psql / make gold (compose.local.yaml)

# Model provider (ADR 0008). Chat returns 503 until the key is set.
MINSKY_LLM_BASE_URL=https://api.openai.com/v1
MINSKY_LLM_MODEL=gpt-6-luna
MINSKY_LLM_API_KEY=

# =============================================================================
# Required for a usable demo (after make gold)
# =============================================================================
# Generate with `make demo-sessions`, paste both lines, then `make up` again.
# JSON: token -> {customer_id|agent_id, expires_at}. Empty = auth fails closed (503).
MINSKY_TEST_SESSIONS=
MINSKY_STAFF_SESSIONS=

# =============================================================================
# Required for the data pipeline (make pipeline / make bronze)
# =============================================================================
# Organizer S3: read-only keys, used only by the pipeline. Never for the API container.
S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Our lake bucket (bronze/silver/gold). Leave empty for the local-download path in docs/demo.md.
# A placeholder profile name makes boto3 fail: leave blank unless you use the team bucket.
BRONZE_URI=
BRONZE_AWS_PROFILE=

# Optional override when POSTGRES_PASSWORD is not "minsky":
# GOLD_DATABASE_URL=postgresql://minsky:minsky@127.0.0.1:5433/minsky

# =============================================================================
# Optional
# =============================================================================
AWS_PROFILE=                      # only for Bedrock (blocked for now, ADR 0008)
OTEL_EXPORTER_OTLP_ENDPOINT=      # e.g. http://phoenix:6006 (compose profile observability)

# Bedrock later (same model, settings only):
# MINSKY_LLM_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
# MINSKY_LLM_MODEL=us.openai.gpt-6-luna
