# Amazon S3 dataset access (read-only)
S3_BUCKET_NAME=your-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Bronze zone (our own bucket). Written with a profile from ~/.aws, not with the organizer keys.
BRONZE_URI=s3://your-bucket/bronze
BRONZE_AWS_PROFILE=your-aws-profile
