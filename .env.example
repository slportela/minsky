# Copy to .env (git-ignored). Never commit real values.

# ---- Source dataset: organizer S3 (read-only keys, used only by the pipeline) ----
S3_BUCKET_NAME=your-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ---- Our bucket: bronze/ and silver/ (written with a profile from ~/.aws, not the keys above) ----
BRONZE_URI=s3://your-bucket/bronze
BRONZE_AWS_PROFILE=your-aws-profile

# ---- Running the stack (make up / compose) ----
AWS_PROFILE=                      # optional: only for Bedrock (blocked for now, ADR 0008); a placeholder name breaks boto3
DOMAIN=localhost                  # the demo host: its public domain, for a Let's Encrypt certificate
MINSKY_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_ENDPOINT=      # optional OTLP HTTP: http://phoenix:6006 (compose profile observability)
POSTGRES_USER=minsky
POSTGRES_PASSWORD=change-me
POSTGRES_DB=minsky
POSTGRES_HOST_PORT=5433             # local only: host port for psql (make up)

# ---- Model provider (ADR 0008): any OpenAI-compatible endpoint ----
# Interim, while Bedrock is blocked for our account: the OpenAI API with a project key that has a budget limit.
# Bedrock later: MINSKY_LLM_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1, MINSKY_LLM_MODEL=us.openai.gpt-6-luna
MINSKY_LLM_BASE_URL=https://api.openai.com/v1
MINSKY_LLM_MODEL=gpt-6-luna
MINSKY_LLM_API_KEY=
# Per-attempt read and connect timeouts, and SDK retries (exponential backoff with jitter):
# MINSKY_LLM_TIMEOUT_S=20
# MINSKY_LLM_CONNECT_TIMEOUT_S=5
# MINSKY_LLM_MAX_RETRIES=2

# Server-provisioned test credentials. JSON mapping: token -> {customer_id, expires_at}.
# Generate random tokens, use timezone-aware expiry, distribute each only to its test user.
MINSKY_TEST_SESSIONS=
# Agent console credentials. JSON mapping: token -> {agent_id, expires_at}. Separate from customer sessions.
# `make demo-sessions` prints both lines, with real demo customers for every policy rule.
MINSKY_STAFF_SESSIONS=
# Demo operators (ADR 0015): a credential that may choose which customer to chat as. Off by default; the API
# refuses to start with it on unless MINSKY_ENVIRONMENT is local or demo. JSON mapping: token -> {operator_id, expires_at}.
MINSKY_DEMO_OPERATOR_ENABLED=false
MINSKY_DEMO_OPERATOR_SESSIONS=
