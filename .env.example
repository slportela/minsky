# Copy to .env (git-ignored). Never commit real values.

# ---- Source dataset: organizer S3 (read-only keys, used only by the pipeline) ----
S3_BUCKET_NAME=your-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ---- Our bucket: bronze/ and silver/ (written with a profile from ~/.aws, not the keys above) ----
BRONZE_URI=s3://your-bucket/bronze
BRONZE_AWS_PROFILE=your-aws-profile

# ---- Running the stack (make up / compose) ----
AWS_PROFILE=your-aws-profile      # local only: a profile with Bedrock access (the demo host uses its instance role)
DOMAIN=localhost                  # the demo host: its public domain, for a Let's Encrypt certificate
MINSKY_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_ENDPOINT=      # optional: http://phoenix:6006 with the observability profile
POSTGRES_USER=minsky
POSTGRES_PASSWORD=change-me
POSTGRES_DB=minsky
POSTGRES_HOST_PORT=5433             # local only: host port for psql (make up)
